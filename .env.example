# SiteSync OS — environment variables
# Copy to `.env` for local development. On Vercel, add these under
# Project → Settings → Environment Variables (Production + Preview).
# Never commit a real `.env`.

# Supabase project URL — Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon / publishable key (safe for the browser; RLS protects data)
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Supabase project ref (used by the Supabase CLI)
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Optional — Blender generation service (services/blender-api). Defaults to localhost:3999.
# VITE_BLENDER_API_URL=https://blender-api.example.com
