# SiteSync Cloud Suite — Environment Variables
# Copy this file to .env and fill in your Supabase credentials.
# Never commit .env to version control.

# Supabase project URL (found in: Supabase Dashboard → Settings → API)
VITE_SUPABASE_URL=

# Supabase anonymous/public key (safe to expose in frontend)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase project ID (used by Supabase CLI)
VITE_SUPABASE_PROJECT_ID=

# Legacy non-VITE_ vars used by supabase CLI locally — same values as above
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Environment identifier — set to "production" on your hosting platform
# Used to suppress dev-only logging and enable production optimizations
VITE_APP_ENV=development
# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# API Configuration
VITE_API_URL=http://localhost:3000

# Development Environment
DEV_API_URL=https://dev-api.sitesyncos.example.com
DEV_SUPABASE_URL=https://dev-project.supabase.co

# Staging Environment
STAGING_API_URL=https://staging-api.sitesyncos.example.com
STAGING_SUPABASE_URL=https://staging-project.supabase.co

# Production Environment
PROD_API_URL=https://api.sitesyncos.example.com
PROD_SUPABASE_URL=https://prod-project.supabase.co

# Application Settings
NODE_ENV=development
DEBUG=false
